---
import '@fontsource-variable/bricolage-grotesque';
// the display face draws the home wordmark (the LCP element), so fetch it early
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { roomKeys, nightRooms, type RoomKey } from '../data/rooms';

interface Props {
  title: string;
  description?: string;
  /** set on room pages; other pages reuse the last room visited */
  room?: RoomKey;
  noindex?: boolean;
}

const { title, description, room, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" data-room={room}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}

    <!-- runs before first paint: theme, remembered room, and room-change wipe -->
    <script is:inline define:vars={{ roomKeys, nightRooms }}>
      const d = document.documentElement;
      const read = (s, k) => { try { return s.getItem(k); } catch { return null; } };
      const write = (s, k, v) => { try { s.setItem(k, v); } catch {} };

      // a saved choice wins; then the room's own default (the researcher opens
      // at night); then the system setting
      let theme = read(localStorage, 'theme');
      if (theme !== 'light' && theme !== 'night') {
        if (nightRooms.includes(d.dataset.room)) theme = 'night';
        else theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'light';
      }
      d.dataset.theme = theme;

      if (d.dataset.room) {
        write(localStorage, 'room', d.dataset.room);
      } else {
        const last = read(localStorage, 'room');
        if (roomKeys.includes(last)) d.dataset.room = last;
      }

      // compare against the page's real room, not a hover preview from the character select
      addEventListener('pageswap', (e) => {
        if (!e.viewTransition) return;
        const from = 'previewFrom' in d.dataset ? d.dataset.previewFrom : d.dataset.room || '';
        write(sessionStorage, 'vt-room', from);
      });
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        const prev = read(sessionStorage, 'vt-room');
        if (prev !== null && prev !== (d.dataset.room || '')) e.viewTransition.types.add('wipe');
      });
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-card border-2 border-line bg-accent px-4 py-2 text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      skip to content
    </a>
    <Nav />
    <main id="main" class="relative flex-1">
      <!-- crop marks at the corners of the content column (see print marks in global.css) -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden sm:block">
        <div class="relative mx-auto h-full max-w-6xl">
          <span class="crop top-6 left-8"></span>
          <span class="crop crop-tr top-6 right-8"></span>
          <span class="crop crop-bl bottom-6 left-8"></span>
          <span class="crop crop-br right-8 bottom-6"></span>
        </div>
      </div>
      <slot />
    </main>
    <Footer />
  </body>
</html>
