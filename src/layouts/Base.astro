---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { roomKeys, type RoomKey } from '../data/rooms';

interface Props {
  title: string;
  description?: string;
  /** set on room pages; other pages reuse the last room visited */
  room?: RoomKey;
  noindex?: boolean;
}

const { title, description, room, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" data-room={room}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}

    <!-- runs before first paint: theme, remembered room, and room-change wipe -->
    <script is:inline define:vars={{ roomKeys }}>
      const d = document.documentElement;
      const read = (s, k) => { try { return s.getItem(k); } catch { return null; } };
      const write = (s, k, v) => { try { s.setItem(k, v); } catch {} };

      let theme = read(localStorage, 'theme');
      if (theme !== 'light' && theme !== 'night') {
        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'light';
      }
      d.dataset.theme = theme;

      if (d.dataset.room) {
        write(localStorage, 'room', d.dataset.room);
      } else {
        const last = read(localStorage, 'room');
        if (roomKeys.includes(last)) d.dataset.room = last;
      }

      addEventListener('pageswap', (e) => {
        if (e.viewTransition) write(sessionStorage, 'vt-room', d.dataset.room || '');
      });
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        const prev = read(sessionStorage, 'vt-room');
        if (prev !== null && prev !== (d.dataset.room || '')) e.viewTransition.types.add('wipe');
      });
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-card border-2 border-line bg-accent px-4 py-2 text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      skip to content
    </a>
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
