---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CharacterSelect from '../components/CharacterSelect.astro';
import SayHi from '../components/SayHi.astro';
---

<Base title="akchhya singh" description="Akchhya Singh: engineer and researcher in Bengaluru. Systems that hold up under load, research on linking heritage records, and a few poems.">
  <div class="mx-auto flex max-w-6xl flex-col gap-16 px-4 py-14 sm:gap-20 sm:px-8 sm:py-20">
    <Hero />
    <CharacterSelect />
    <SayHi />
  </div>
</Base>
