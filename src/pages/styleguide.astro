---
import Base, { type Room } from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CatalogueCard from '../components/CatalogueCard.astro';

const palette = [
  { name: 'paper', hex: '#FBF0E8', role: 'canvas', note: 'ink on it 16.5:1', cls: 'bg-paper text-ink' },
  { name: 'ink', hex: '#1E0A2E', role: 'text, lines, night canvas', note: 'paper on it 16.5:1', cls: 'bg-ink text-paper' },
  { name: 'plum', hex: '#4A1468', role: 'headings, primary buttons', note: 'on paper 11.8:1', cls: 'bg-plum text-paper' },
  { name: 'lilac', hex: '#C9B6FF', role: 'the researcher', note: 'ink on it 10.2:1', cls: 'bg-lilac text-ink' },
  { name: 'lime', hex: '#D4F36B', role: 'the technobrat', note: 'ink on it 14.8:1', cls: 'bg-lime text-ink' },
  { name: 'tangerine', hex: '#FF6B2C', role: 'the marketer', note: 'ink on it 6.5:1', cls: 'bg-tangerine text-ink' },
  { name: 'sky', hex: '#9FD3FF', role: 'the creative caterpillar', note: 'ink on it 11.6:1', cls: 'bg-sky text-ink' },
  { name: 'bubblegum', hex: '#FF9ECF', role: 'the organiser', note: 'ink on it 9.7:1', cls: 'bg-bubblegum text-ink' },
];

const scale = [
  { name: 'display', spec: '56 → 144px · 800 · 0.95 · -0.04em', cls: 'font-display text-display text-strong', sample: 'pick a version.' },
  { name: 'h1', spec: '40 → 72px · 800 · 0.95 · -0.03em', cls: 'font-display text-h1 text-strong', sample: 'things i built that didn’t fall over' },
  { name: 'h2', spec: '26 → 36px · 700 · 1.1 · -0.015em', cls: 'font-display text-h2 text-strong', sample: 'distributed rate limiter' },
  { name: 'h3', spec: '20 → 24px · 600 · 1.25', cls: 'font-display text-h3 text-strong', sample: 'two decisions and what i chose instead' },
  { name: 'body', spec: 'Geist · 17 → 18px · 1.6', cls: 'font-sans text-body', sample: 'A token bucket refills at a fixed rate and rejects requests once it is empty. The playground lets you change both and watch it happen.' },
  { name: 'small', spec: 'Geist · 15px · 1.5', cls: 'font-sans text-small', sample: 'Published at ICICACS 2026 · 140K req/s · 1.8M launch impressions' },
  { name: 'mono', spec: 'Geist Mono · 14px · 1.5', cls: 'font-mono text-mono', sample: 'const tokens = Math.min(capacity, tokens + rate * dt);' },
  { name: 'label', spec: 'Geist Mono · 12px · uppercase · +0.06em', cls: 'label', sample: '2026 · rust · tokio · redis' },
  { name: 'serif', spec: 'Instrument Serif italic · editorial only', cls: 'font-serif italic text-h2 font-normal', sample: '“the part of me that isn’t optimising anything.”' },
];

const rooms: { key: Room; name: string; label: string; intro: string }[] = [
  { key: 'researcher', name: 'the researcher', label: 'research', intro: 'i like data that’s messy, incomplete and hiding something.' },
  { key: 'technobrat', name: 'the technobrat', label: 'engineering & projects', intro: 'things i built that didn’t fall over. mostly.' },
  { key: 'marketer', name: 'the marketer', label: 'growth & marketing', intro: 'i make people care about products.' },
  { key: 'caterpillar', name: 'the creative caterpillar', label: 'writing & art', intro: 'essays, poems, sketches.' },
  { key: 'organiser', name: 'the organiser', label: 'community & organising', intro: 'getting 40 people into one room on time.' },
];

const themes = ['light', 'night'] as const;
---

<Base title="styleguide · akchhya" description="Design tokens, type scale and components for akchhya.xyz." noindex>
  <main class="mx-auto flex max-w-6xl flex-col gap-20 px-4 py-16 sm:px-8">
    <header class="flex flex-col gap-4">
      <p class="label">phase 2 · design system</p>
      <h1 class="text-h1">styleguide</h1>
      <p class="max-w-prose">Every token, type size, card and button, in all five rooms, light and night.</p>
    </header>

    <section aria-labelledby="colors" class="flex flex-col gap-6">
      <h2 id="colors" class="text-h2">colors</h2>
      <p class="max-w-prose text-small">
        Accents are fills, never text on paper (1.1 to 2.5:1). Anything on an accent uses <code class="font-mono text-mono">text-on-accent</code>.
      </p>
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        {palette.map((c) => (
          <li class={`flex aspect-[4/3] flex-col justify-between rounded-card border-2 border-line p-4 ${c.cls}`}>
            <span class="font-display text-h3">{c.name}</span>
            <span class="flex flex-col">
              <span class="label">{c.hex}</span>
              <span class="text-small">{c.role}</span>
              <span class="label opacity-80">{c.note}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="type" class="flex flex-col gap-6">
      <h2 id="type" class="text-h2">type scale</h2>
      <dl class="flex flex-col divide-y-2 divide-dashed divide-line border-y-2 border-line">
        {scale.map((t) => (
          <div class="grid gap-2 py-6 md:grid-cols-[12rem_1fr] md:gap-8">
            <dt class="flex flex-col">
              <span class="label">{t.name}</span>
              <span class="font-mono text-mono opacity-80">{t.spec}</span>
            </dt>
            <dd class={`${t.cls} min-w-0 break-words`}>{t.sample}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="leading" class="flex flex-col gap-6">
      <h2 id="leading" class="text-h2">display leading check</h2>
      <p class="max-w-prose text-small">
        At 0.88, descenders on one line hit ascenders on the next. At 0.95 they clear. Inside
        overflow-hidden masks, wrap each line in <code class="font-mono text-mono">mask-line</code> so descenders aren’t cut.
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        <figure class="flex flex-col gap-2">
          <p class="font-display text-display text-strong" style="line-height:0.88">jumpy<br />kgb</p>
          <figcaption class="label">0.88, collides</figcaption>
        </figure>
        <figure class="flex flex-col gap-2">
          <p class="font-display text-display text-strong">jumpy<br />kgb</p>
          <figcaption class="label">0.95, clears</figcaption>
        </figure>
        <figure class="flex flex-col gap-2">
          <p class="font-display text-display text-strong"><span class="block overflow-hidden outline-2 outline-dashed outline-line">jumpy</span></p>
          <figcaption class="label">overflow-hidden, clipped</figcaption>
        </figure>
        <figure class="flex flex-col gap-2">
          <p class="font-display text-display text-strong"><span class="mask-line outline-2 outline-dashed outline-line">jumpy</span></p>
          <figcaption class="label">mask-line, safe</figcaption>
        </figure>
      </div>
    </section>

    <section aria-labelledby="links" class="flex flex-col gap-6">
      <h2 id="links" class="text-h2">links and stickers</h2>
      <p class="max-w-prose">
        Read the <a href="#rooms">HeritageRec paper</a> or skip to the <a href="#rooms">rooms</a>.
        <span class="label ml-1 inline-block -rotate-2 rounded-sticker border-2 border-line bg-accent px-2 py-0.5 text-on-accent">new</span>
      </p>
    </section>

    {themes.map((theme) => (
      <section
        aria-labelledby={`rooms-${theme}`}
        data-theme={theme}
        class="-mx-4 flex flex-col gap-8 rounded-card bg-surface px-4 py-12 text-text sm:-mx-8 sm:px-8"
        id={theme === 'light' ? 'rooms' : undefined}
      >
        <h2 id={`rooms-${theme}`} class="text-h2">rooms · {theme}</h2>
        <div class="grid gap-10 md:grid-cols-2 xl:grid-cols-3">
          {rooms.map((r, i) => (
            <div data-room={r.key} class="flex flex-col gap-5">
              <div class="flex flex-col gap-1">
                <span class="font-display text-h3 text-strong">
                  <span class="rounded-sticker bg-accent px-1.5 text-on-accent">{r.name}</span>
                </span>
                <span class="label">{r.label}</span>
              </div>
              <p class="text-small">{r.intro}</p>
              <div class="flex flex-wrap gap-3">
                <Button variant="accent">enter room</Button>
                <Button variant="primary">primary</Button>
                <Button variant="ghost">ghost</Button>
              </div>
              <CatalogueCard
                title="distributed rate limiter"
                blurb="Token bucket in Rust, sharded over Redis. Holds 140K requests a second."
                date="2025"
                stack={['rust', 'tokio', 'redis']}
                role="solo"
                status="live"
                href="#"
                tilt={i % 2 === 0 ? 'left' : 'right'}
              />
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>
