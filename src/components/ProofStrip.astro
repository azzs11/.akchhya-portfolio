---
/*
  proof, as three die-cut stickers slapped beside the hero.
  each is a link, so each gets the hard shadow (box rule), outside a white
  vinyl ring and a thin cut line. three fills, still only one accent:
  accent (the seal), ink (the pill), vinyl (the ticket).
  on hover or focus a sticker straightens and lifts.
  lives in Hero's "proof" slot and positions itself against the hero.
*/
const proof = [
  {
    kind: 'seal',
    href: '/research',
    tilt: '-9deg',
    parts: [
      { text: 'heritagerec', cls: 'label' },
      { text: 'published', cls: 'seal-big' },
      { text: 'icicacs 2026', cls: 'label' },
    ],
  },
  {
    kind: 'pill',
    href: '/build',
    tilt: '5deg',
    parts: [
      { text: '140K', cls: 'num' },
      { text: 'req/s · rate limiter', cls: 'label' },
    ],
  },
  {
    kind: 'ticket',
    href: '/product',
    tilt: '-3deg',
    parts: [
      { text: '1.8M', cls: 'num' },
      { text: 'launch impressions', cls: 'label ticket-stub' },
      { text: 'libra ai', cls: 'label' },
    ],
  },
];
---

<ul class="proof" aria-label="proof">
  {
    proof.map((p, i) => (
      <li style={`--tilt:${p.tilt}; --i:${i}`}>
        <a href={p.href} class={`sticker sticker-${p.kind}`}>
          {p.parts.map((part, j) => (
            <>
              {j > 0 && <span class="sr-only">, </span>}
              <span class={part.cls}>{part.text}</span>
            </>
          ))}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .proof {
    --vinyl: #fffdf9; /* sticker white, a touch brighter than the paper */
    --ring: 0.3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 1.25rem;
    margin-top: 2.5rem;
    padding-left: var(--ring);
  }

  /* wide: stuck in the empty band beside "hi i'm", overlapping each other */
  @container (min-width: 60rem) {
    .proof {
      position: absolute;
      top: 3.4rem;
      right: 0.5rem;
      margin: 0;
      gap: 0;
      flex-wrap: nowrap;
    }

    .proof li + li {
      margin-left: -0.5rem;
    }

    /* stacked left over right, like they were stuck down in that order */
    .proof li:nth-child(1) { z-index: 3; }
    .proof li:nth-child(2) { z-index: 2; translate: 0 0.9rem; }
    .proof li:nth-child(3) { z-index: 1; }

    .proof .num { font-size: 2.6rem; }
    .proof .sticker-seal { width: 8rem; }
    .proof .sticker-pill { padding: 0.7rem 1.3rem 0.8rem; }
  }

  .proof li {
    rotate: var(--tilt);
    transition: rotate var(--duration-slow) var(--ease-spring);
  }

  .proof li:has(.sticker:hover, .sticker:focus-visible) {
    rotate: 0deg;
    z-index: 4;
  }

  .sticker {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--on-accent);
    box-shadow:
      0 0 0 var(--ring) var(--vinyl),
      0 0 0 calc(var(--ring) + 1.5px) var(--line),
      4px 4px 0 calc(var(--ring) + 1.5px) var(--line);
    transition:
      translate var(--duration-quick) var(--ease-spring),
      box-shadow var(--duration-quick) ease;
  }

  .sticker:hover,
  .sticker:focus-visible {
    translate: -2px -2px;
    box-shadow:
      0 0 0 var(--ring) var(--vinyl),
      0 0 0 calc(var(--ring) + 1.5px) var(--line),
      6px 6px 0 calc(var(--ring) + 1.5px) var(--line);
  }

  .sticker:focus-visible {
    outline-offset: calc(var(--ring) + 5px);
  }

  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.1rem;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  /* seal: a round accent badge */
  .sticker-seal {
    width: 7rem;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border-radius: 50%;
    background-color: var(--accent);
    text-align: center;
    transition:
      translate var(--duration-quick) var(--ease-spring),
      box-shadow var(--duration-quick) ease,
      background-color var(--duration-base) ease;
  }

  .seal-big {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* pill: ink, like the night theme */
  .sticker-pill {
    gap: 0.25rem;
    padding: 0.6rem 1rem 0.7rem;
    border-radius: 999px;
    background-color: var(--color-ink);
    color: var(--color-paper);
  }

  /* ticket: vinyl with a dashed tear line before the stub */
  .sticker-ticket {
    gap: 0.15rem;
    padding: 0.75rem 1rem 0.7rem;
    border-radius: var(--radius-sticker);
    background-color: var(--vinyl);
    color: var(--color-ink);
    max-width: 11rem;
  }

  .ticket-stub {
    margin-top: 0.3rem;
    padding-top: 0.45rem;
    border-top: 1.5px dashed var(--color-ink);
  }

  /* entrance: slapped on one after another, once the dot has stamped */
  @media (prefers-reduced-motion: no-preference) {
    .sticker {
      animation: slap 420ms var(--ease-spring) calc(950ms + var(--i) * 130ms) both;
    }
  }

  @keyframes slap {
    from { scale: 1.35; opacity: 0; }
    to { scale: 1; opacity: 1; }
  }
</style>
