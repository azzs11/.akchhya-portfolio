---
const proof = [
  { big: 'published', small: 'heritagerec · icicacs 2026', href: '/research' },
  { big: '140K', small: 'requests a second · rate limiter', href: '/build' },
  { big: '1.8M', small: 'launch impressions · libra ai', href: '/growth' },
];
---

<section aria-label="proof" class="border-y-2 border-line">
  <ul class="grid divide-line sm:grid-cols-3 sm:divide-x-2 max-sm:divide-y-2">
    {
      proof.map((p) => (
        <li>
          <a href={p.href} class="group flex flex-col gap-1 px-1 py-6 no-underline sm:px-6">
            <span class="font-display text-h1 text-strong">
              <span class="bg-[linear-gradient(var(--accent),var(--accent))] bg-[length:100%_0.18em] bg-[position:left_bottom] bg-no-repeat transition-[background-size] duration-300 ease-spring group-hover:bg-[length:100%_100%] group-hover:text-on-accent">
                {p.big}
              </span>
            </span>
            <span class="label text-text">{p.small}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
